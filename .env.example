# Copie para .env e preencha. NUNCA commite o .env real.

# Neon Postgres
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"  # pooled (runtime)
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"    # direta (migrations)

# Upstash
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# PSP (Mercado Pago)
PSP_PROVIDER="mercadopago"
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# Public key (client-side card tokenization Brick). NOT a secret. Without it,
# the card option is hidden and only Pix is offered.
MERCADOPAGO_PUBLIC_KEY=""

# Mailtrap
MAILTRAP_API_TOKEN=""
MAILTRAP_SENDER_EMAIL=""

# Cloudinary (somente imagens públicas de evento)
CLOUDINARY_URL=""

# Cloudflare R2 (arquivos privados: exports, pacotes offline)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Observabilidade
SENTRY_DSN=""

# URL pública da aplicação (links de ingresso/e-mail)
APP_BASE_URL="http://localhost:3000"

# DEC-012 — chave de 32 bytes (64 hex) p/ cifrar o segredo TOTP. Presente = MFA obrigatório.
# Gerar: node -e "console.log(require(\047crypto\047).randomBytes(32).toString(\047hex\047))"
MFA_ENCRYPTION_KEY=

# DEC-003 — e-mails (separados por vírgula) que acessam a área de admin da
# plataforma (/plataforma): configuração de taxa por org/evento e repasses.
# Não existe papel de admin de plataforma — esta allowlist é o único gate.
PLATFORM_ADMIN_EMAILS=

# Multi-tenant (docs/MULTITENANT.md) — plano de controle
# Banco da plataforma (registro de tenants, identidade global, roteamento)
PLATFORM_DATABASE_URL=""
PLATFORM_DIRECT_URL=""
# Chave AES-256-GCM (64 hex) que cifra as connection strings dos tenants.
# Gerar: openssl rand -hex 32
ENCRYPTION_KEY_PLATFORM_DB=""
